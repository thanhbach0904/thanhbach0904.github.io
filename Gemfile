source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-feed"
gem "jekyll-seo-tag"

# Windows lacks the IANA zoneinfo database that tzinfo needs to resolve
# _config.yml's `timezone: Asia/Ho_Chi_Minh` (Jekyll build otherwise
# raises TZInfo::DataSources::ZoneinfoDirectoryNotFound).
gem "tzinfo-data", platforms: [:windows, :jruby]
